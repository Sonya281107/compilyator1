// Тест A.2.12: видимость pub/priv

struct Account {
    pub  balance: i64,
    pub  owner:   i64,   // условный ID владельца
}

impl Account {
    // Публичные методы доступны снаружи
    pub fn deposit(self: Account, amount: i64) -> Account {
        return Account { balance: self.balance + amount, owner: self.owner };
    }
    pub fn withdraw(self: Account, amount: i64) -> Account {
        return Account { balance: self.balance - amount, owner: self.owner };
    }
    pub fn get_balance(self: Account) -> i64 {
        return self.balance;
    }
    // Приватный метод: вызывается только внутри impl
    fn validate(self: Account) -> bool {
        return self.balance >= 0;
    }
    pub fn is_valid(self: Account) -> bool {
        return self.validate();   // priv-метод вызывается изнутри impl
    }
}

fn main() -> i64 {
    let mut acc: Account = Account { balance: 100, owner: 1 };
    acc = acc.deposit(50);
    print(acc.get_balance());     // 150

    acc = acc.withdraw(30);
    print(acc.get_balance());     // 120

    print(acc.balance);           // 120  (pub поле доступно снаружи)
    print(acc.is_valid());        // true

    return 0;
}
// ожидаемый вывод: 150  120  120  true
