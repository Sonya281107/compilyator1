// Тест B.3.6: распределение регистров методом раскраски графа
//
// Больше переменных, чем регистров r12-r15 (4 штуки) — некоторые должны
// корректно уйти на стек (spill), но результат вычислений должен быть верным.

fn compute(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    // 5 параметров + локальные → регистров не хватит на все
    let p: i64 = a * b;
    let q: i64 = c * d;
    let r: i64 = p + q;
    let s: i64 = r - e;
    let t: i64 = s * 2;
    let u: i64 = t + a + b + c;
    return u;
}

fn main() -> i64 {
    // Много переменных в одной функции
    let v0: i64 = 1;
    let v1: i64 = 2;
    let v2: i64 = 3;
    let v3: i64 = 4;
    let v4: i64 = 5;
    let v5: i64 = 6;
    let v6: i64 = 7;
    let v7: i64 = 8;

    let s1: i64 = v0 + v1 + v2 + v3;   // 10
    let s2: i64 = v4 + v5 + v6 + v7;   // 26
    print(s1);                           // 10
    print(s2);                           // 26
    print(s1 + s2);                      // 36

    // Вызов функции с 5 аргументами
    // compute(2,3,4,5,6) = (2*3 + 4*5 - 6)*2 + 2+3+4 = (6+20-6)*2+9 = 40+9 = 49
    print(compute(2, 3, 4, 5, 6));      // 49

    return 0;
}
// ожидаемый вывод: 10  26  36  49
