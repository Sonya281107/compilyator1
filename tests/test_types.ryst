// Тест числовых типов и суффиксов (A.1.1)
fn main() -> i64 {
    let a: i8  = 127i8;
    let b: u8  = 255u8;
    let c: i32 = 2147483647i32;
    let d: f32 = 1.5f32;
    let e: f64 = 3.14;
    print(a as i64);        // 127
    print(b as i64);        // 255
    print(c as i64);        // 2147483647
    print(d as f64);        // 1.5
    print(e);               // 3.14
    return 0;
}
