// Математические функции: степень, факториал, НОД

fn power(base: i64, exp: i64) -> i64 {
    let mut result: i64 = 1;
    let mut e: i64 = exp;
    while e > 0 {
        result = result * base;
        e = e - 1;
    }
    return result;
}

fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    let mut result: i64 = 1;
    let mut i: i64 = 2;
    while i <= n {
        result = result * i;
        i = i + 1;
    }
    return result;
}

fn gcd(a: i64, b: i64) -> i64 {
    let mut x: i64 = a;
    let mut y: i64 = b;
    while y != 0 {
        let mut tmp: i64 = y;
        y = x % y;
        x = tmp;
    }
    return x;
}

fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    let mut i: i64 = 2;
    while i * i <= n {
        if n % i == 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn main() {
    print(power(2, 10));     // 1024
    print(power(3, 5));      // 243

    print(factorial(5));     // 120
    print(factorial(10));    // 3628800

    print(gcd(48, 18));      // 6
    print(gcd(100, 75));     // 25

    // простые числа от 2 до 20
    let mut n: i64 = 2;
    while n <= 20 {
        if is_prime(n) {
            print(n);
        }
        n = n + 1;
    }
}
