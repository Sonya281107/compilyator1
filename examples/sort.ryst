// Сортировка пузырьком массива из 8 элементов

fn print_array(arr: [i64; 8]) {
    let mut i: i64 = 0;
    while i < 8 {
        print(arr[i]);
        i = i + 1;
    }
}

fn main() {
    let mut arr: [i64; 8] = [64, 34, 25, 12, 22, 11, 90, 1];

    // Сортировка пузырьком
    let mut i: i64 = 0;
    while i < 7 {
        let mut j: i64 = 0;
        while j < 7 - i {
            if arr[j] > arr[j + 1] {
                let mut tmp: i64 = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    print_array(arr);   // 1 11 12 22 25 34 64 90
}
