// Двумерный вектор с перегрузкой операторов (A.2.11)

struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    fn __add__(self: Vec2, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }

    fn __sub__(self: Vec2, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x - other.x, y: self.y - other.y };
    }

    fn __eq__(self: Vec2, other: Vec2) -> bool {
        return self.x == other.x && self.y == other.y;
    }

    fn scale(self: Vec2, factor: f64) -> Vec2 {
        return Vec2 { x: self.x * factor, y: self.y * factor };
    }

    fn dot(self: Vec2, other: Vec2) -> f64 {
        return self.x * other.x + self.y * other.y;
    }

    fn len_sq(self: Vec2) -> f64 {
        return self.x * self.x + self.y * self.y;
    }

    fn print_vec(self: Vec2) {
        print(self.x);
        print(self.y);
    }
}

fn main() {
    let a: Vec2 = Vec2 { x: 1.0, y: 2.0 };
    let b: Vec2 = Vec2 { x: 3.0, y: 4.0 };

    let c: Vec2 = a + b;
    c.print_vec();          // 4.0  6.0

    let d: Vec2 = b - a;
    d.print_vec();          // 2.0  2.0

    let e: Vec2 = a.scale(3.0);
    e.print_vec();          // 3.0  6.0

    print(a.dot(b));        // 11.0  (1*3 + 2*4)
    print(b.len_sq());      // 25.0  (3^2 + 4^2)

    let zero: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    print(zero == zero);    // true
    print(a == b);          // false
}
